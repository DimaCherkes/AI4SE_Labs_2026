# ==============================================================================
# Environment Configuration Template for Task 1: Requirements Agent
# Copy this file to '.env' and populate with your valid OpenAI API key.
# DO NOT commit '.env' to version control!
# ==============================================================================

# OpenAI API Key (Required for live end-to-end LLM runs)
OPENAI_API_KEY=your_key_here

# Optional: Default Model Overrides (Must be from allowed list:
# gpt-6-luna, gpt-5.6-luna, gpt-5.4-nano, gpt-5-nano, gpt-5-mini, gpt-4.1-nano, gpt-4o-mini)
MODEL_EXTRACTOR=gpt-5-mini
MODEL_RESOLVER=gpt-5.4-nano
MODEL_AUDITOR=gpt-6-luna

# Optional: Loop & Pipeline Settings
MAX_ITERATIONS=3
